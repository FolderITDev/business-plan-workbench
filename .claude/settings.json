{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "WebFetch",
      "WebSearch",

      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(telnet *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "Bash(rsync *)",

      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(rm -Rf *)",
      "Bash(del /*)",
      "Bash(del /s *)",
      "Bash(rd /s *)",
      "Bash(rmdir /s *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(format *)",
      "Bash(shred *)",
      "Bash(sudo *)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git filter-branch *)",
      "Bash(git update-ref -d *)",
      "Bash(git reflog expire *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git restore *)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",

      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.claude/**)",
      "Edit(/etc/**)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.env)",

      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(chmod -R *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)"
    ]
  }
}
